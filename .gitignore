# ─── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Python cache ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ─── Pytest / test cache ─────────────────────────────────────────────────────
.pytest_cache/
.cache/
*.pyc

# ─── Data files (raw cache — regenerated by etl.py) ─────────────────────────
# Keep data/raw/ files out of git; they are ephemeral API caches.
# Keep data/processed/ files out of git; they are regenerated by etl.py.
# The /data/ directories themselves (with .gitkeep) are tracked so the
# folder structure exists after a fresh clone.
data/raw/*.json
data/processed/*.parquet
data/processed/quality_report.json

# ─── OS / editor artefacts ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# ─── Build / distribution ────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ─── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Environment / secrets ───────────────────────────────────────────────────
.env
.env.*
*.pem
*.key
